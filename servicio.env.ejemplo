# Copia este archivo a .env y rellena. Nunca subas el .env al repositorio.
PUERTO=8090
HOST=127.0.0.1
# Clave de la API de Claude, solo para el chatbot (no la del auditor).
ANTHROPIC_API_KEY=
# Modelo por defecto; cada negocio puede cambiarlo en su ficha.
MODELO=claude-haiku-5-5
# Tope de gasto de todo el servicio en dólares por día. Al llegar, el bot deriva sin llamar al modelo.
TOPE_GASTO_DIARIO=2
# Carpeta de datos (base SQLite).
DATOS=datos-chatbot
